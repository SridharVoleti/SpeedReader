# BabySteps -> Speed Reading browser handoff (POST /launch)
# See docs/app-launch-integration.md. All provisioned by BabySteps at onboarding and handed
# over through a secure channel - never commit real values. Server-side only.
# Generate a dev Ed25519 keypair:
#   node -e "const {publicKey,privateKey}=require('crypto').generateKeyPairSync('ed25519');console.log('APP_LAUNCH_SIGNING_PRIVATE_KEY='+JSON.stringify(privateKey.export({format:'jwk'})));console.log('# public (give to BabySteps): '+JSON.stringify(publicKey.export({format:'jwk'})));"
APP_LAUNCH_CLIENT_ID=
APP_LAUNCH_SIGNING_PRIVATE_KEY=
APP_LAUNCH_BOOTSTRAP_SECRET=            # 32+ char HS256 shared secret
APP_LAUNCH_APP_ID=
APP_LAUNCH_ENVIRONMENT=
APP_LAUNCH_DEPLOYMENT_ID=
# Optional - defaults shown
# APP_LAUNCH_APP_KEY=speed-reader   # app_registry key (NOT client_id); when set, the
#                                   # bootstrap assertion's app_key claim is verified against it
# APP_LAUNCH_EXCHANGE_URL=https://www.babystepsindia.com/v1/internal/app-launch/exchange
# APP_LAUNCH_BOOTSTRAP_ISSUER=https://babysteps.in
# APP_LAUNCH_RETURN_URL=https://www.babystepsindia.com
# APP_LAUNCH_LANDING_PATH=/

# Our own local session cookie (lib/app-launch/session.ts) - NOT shared with BabySteps.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- V3 production runtime (server-side only; never expose to the browser; never commit real values) ----
# Learner state is server-authoritative. On a Vercel production deployment (VERCEL_ENV=production) the app fails closed:
# without a valid https SUPABASE_URL and a service-role key, /health returns 503 CONFIGURATION_ERROR and /api/v3 returns
# 503 SERVER_CONFIGURATION; it never falls back to local files. Apply hosted-app/supabase/migrations first.
# Persistence (REQUIRED in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local development / tests only: file storage root used when the Supabase variables are absent outside production
# SR_DATA_DIR=./.data
# Approved learning content packages (production reads approved content only)
SR_APPROVED_ROOT=
# SR_WIP_ROOT=                      # work-in-progress packages; non-production previews only
# Internal operational endpoints (16+ chars); NOT the parent-authorization mechanism
SR_INTERNAL_API_KEY=
# Canonical authority inputs for conformance validation (see the QA/CI documentation)
# SR_CANONICAL_DIR=
# Diagnostics and anonymous access: NEVER set in production (ignored there even if set).
# SR_ENABLE_DIAGNOSTICS=true        # mounts diagnostics routes incl. legacy /explain, outside production only
# SR_ALLOW_ANONYMOUS_LEARNER=true   # local development only
